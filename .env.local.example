# Copiar a .env.local y rellenar valores reales
# .env.local está en .gitignore — nunca commitear

# Supabase — copiar del botón "Connect" en el dashboard
# Settings → API Keys para las keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Cloudflare R2 (https://dash.cloudflare.com/ → R2 → Manage API Tokens)
R2_ACCOUNT_ID=abc123
R2_ACCESS_KEY_ID=abc123
R2_SECRET_ACCESS_KEY=abc123
R2_BUCKET_NAME=splatter-storage
R2_PUBLIC_URL=https://pub-xxx.r2.dev
# O si tienes dominio custom: https://storage.splatter.mx

# RunPod (https://www.runpod.io/console/serverless)
RUNPOD_API_KEY=rpa_xxx
RUNPOD_ENDPOINT_ID=abc123
RUNPOD_WEBHOOK_SECRET=un-string-aleatorio-largo

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
